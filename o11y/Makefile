#This file has been retrieved from https://github.com/elastic/cluster-mgmt-resources/tree/main/blessed via `make update`.
#DO NOT EDIT THIS FILE.

default: help

CLUSTER_MGMT=./managed/run
BRANCH ?= main
GITHUB_TOKEN_FILE=$(HOME)/.elastic/github.token
ENV_FILE := .env

ifndef GITHUB_TOKEN
  ifneq (,$(wildcard $(GITHUB_TOKEN_FILE)))
    $(info Using GITHUB_TOKEN from $(GITHUB_TOKEN_FILE))
    GITHUB_TOKEN := $(shell cat $(GITHUB_TOKEN_FILE))
  else ifneq (,$(wildcard $(ENV_FILE)))
    $(info Using GITHUB_TOKEN from $(ENV_FILE))
    include $(ENV_FILE)
  endif
endif

ifndef GITHUB_TOKEN
  $(error GITHUB_TOKEN is not set. Set it via environment, $(GITHUB_TOKEN_FILE), or $(ENV_FILE))
endif

export GITHUB_TOKEN

plan: check-version ## Runs a plan against all local resources
	$(CLUSTER_MGMT) plan

print-config: check-version  ## Prints config for given environment
	$(CLUSTER_MGMT) print-config

apply: check-version ## Applies all local resources -- usually done in CI
	$(CLUSTER_MGMT) apply

unlock: check-version ## Unlocks the Terraform state for the given environment
	$(CLUSTER_MGMT) unlock

import: check-version ## Associates a locally defined resource with a remote resource ID in the terraform state
	$(CLUSTER_MGMT) import

destroy: check-version ## Destroys all resources for the given environment
	$(CLUSTER_MGMT) destroy

taint: check-version ## Taints space delimited list of resources in RESOURCES environment variable
	@if [ -z "$(TAINT_RESOURCES)" ]; then \
		echo "Error: No resources specified. USAGE: make taint TAINT_RESOURCES='mymodule.resource_type.resource1 mymodule.resource_type.resource2 ...'"; \
		exit 1; \
	fi
	$(CLUSTER_MGMT) taint

update: ## Updates makeware to the latest version
	@UPDATE_SCRIPT=$$(mktemp) && curl -sL https://$(GITHUB_TOKEN)@raw.githubusercontent.com/elastic/cluster-mgmt-resources/refs/heads/$(BRANCH)/scripts/update -o $$UPDATE_SCRIPT && bash -i $$UPDATE_SCRIPT

check-version: ## Checks if makeware is up to date
	@./managed/check-version

help: ## Display this help screen
	@echo "Usage: make <target>"
	@echo ""
	@echo "Targets:"
	@echo ""
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

